{
  "schema_version": "1",
  "models": [
    {
      "id": "hand",
      "version": "1",
      "title": "汉德公式：预防成本与风险减少",
      "category": "decision",
      "question": "指定措施减少的预期损失，是否超过其同期间成本？",
      "output_kind": "economic_comparison",
      "formula_summary": "ΔEL = NpL(eₚ+eₗ−eₚeₗ)，等价于措施前后预期损失之差；净收益 = ΔEL − B",
      "legal_status": "源自美国侵权判例的风险权衡；这里采用增量预期损失的经济扩展，不自动认定违反注意义务。",
      "assumptions": [
        "暴露次数、概率、损失与预防成本使用同一期间和一致货币口径。",
        "L为事故发生后的条件平均损失；p为每次暴露事故概率。",
        "两种措施效果分别作用于事故概率与条件损失，且未重复计入。",
        "忽略风险厌恶、外部未计量利益及不可货币化限制。"
      ],
      "limitations": [
        "经济上有净收益不等于法律上负有采取措施义务。",
        "p与措施效果必须有数据或明确假设；不能由结果反推当时可预见性。",
        "等号只表示经济收支相等；此模型采用严格大于作为净收益为正条件。"
      ],
      "required_legal_findings": [
        "相关注意义务及标准",
        "风险可预见性与措施可行性",
        "适用法是否及如何允许经济权衡"
      ],
      "source_ids": [
        "hand-carroll"
      ],
      "fields": [
        {
          "id": "N",
          "label": "同期间暴露次数",
          "unit": "次",
          "description": "",
          "type": "number",
          "min": 0
        },
        {
          "id": "p",
          "label": "每次暴露事故概率",
          "unit": "0–1比例",
          "description": "",
          "type": "number",
          "min": 0,
          "max": 1
        },
        {
          "id": "L",
          "label": "事故条件平均损失",
          "unit": "同一货币单位",
          "description": "",
          "type": "number",
          "min": 0
        },
        {
          "id": "annual_B",
          "label": "同期间预防成本",
          "unit": "同一货币单位",
          "description": "默认年度；更换期间时全部输入同步。",
          "type": "number",
          "min": 0
        },
        {
          "id": "prob_reduction",
          "label": "事故概率降低比例",
          "unit": "0–1比例",
          "description": "",
          "type": "number",
          "min": 0,
          "max": 1
        },
        {
          "id": "severity_reduction",
          "label": "条件损失降低比例",
          "unit": "0–1比例",
          "description": "",
          "type": "number",
          "min": 0,
          "max": 1
        }
      ],
      "outputs": [
        {
          "id": "expected_before",
          "label": "措施前预期损失",
          "unit": "货币/期间",
          "formula": "NpL",
          "expression": {
            "op": "mul",
            "args": [
              {
                "var": "input.N"
              },
              {
                "var": "input.p"
              },
              {
                "var": "input.L"
              }
            ]
          }
        },
        {
          "id": "expected_after",
          "label": "措施后预期损失",
          "unit": "货币/期间",
          "formula": "Np(1−eₚ)L(1−eₗ)",
          "expression": {
            "op": "mul",
            "args": [
              {
                "var": "input.N"
              },
              {
                "var": "input.p"
              },
              {
                "op": "sub",
                "args": [
                  1,
                  {
                    "var": "input.prob_reduction"
                  }
                ]
              },
              {
                "var": "input.L"
              },
              {
                "op": "sub",
                "args": [
                  1,
                  {
                    "var": "input.severity_reduction"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "avoided_expected_loss",
          "label": "减少的预期损失",
          "unit": "货币/期间",
          "formula": "NpL(eₚ+eₗ−eₚeₗ)，等价于EL前−EL后",
          "expression": {
            "op": "mul",
            "args": [
              {
                "var": "out.expected_before"
              },
              {
                "op": "sub",
                "args": [
                  {
                    "op": "add",
                    "args": [
                      {
                        "var": "input.prob_reduction"
                      },
                      {
                        "var": "input.severity_reduction"
                      }
                    ]
                  },
                  {
                    "op": "mul",
                    "args": [
                      {
                        "var": "input.prob_reduction"
                      },
                      {
                        "var": "input.severity_reduction"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "net_benefit",
          "label": "经济净收益",
          "unit": "货币/期间",
          "formula": "ΔEL−B",
          "expression": {
            "op": "sub",
            "args": [
              {
                "var": "out.avoided_expected_loss"
              },
              {
                "var": "input.annual_B"
              }
            ]
          }
        },
        {
          "id": "economically_favourable",
          "label": "经济净收益是否为正",
          "unit": "布尔值",
          "formula": "ΔEL>B",
          "expression": {
            "op": "gt",
            "args": [
              {
                "var": "out.avoided_expected_loss"
              },
              {
                "var": "input.annual_B"
              }
            ]
          }
        }
      ],
      "constraints": [],
      "example_inputs": {
        "N": 100000,
        "p": 8e-05,
        "L": 104000,
        "annual_B": 120000,
        "prob_reduction": 0.6,
        "severity_reduction": 0
      },
      "example_basis": "hypothetical"
    },
    {
      "id": "alexy",
      "version": "1",
      "title": "Alexy权重公式：原则间的理论权衡",
      "category": "balancing",
      "question": "给定有争议的强度与可靠性等级，理论权重比如何变化？",
      "output_kind": "theoretical_weight_ratio",
      "formula_summary": "Wᵢⱼ = (IᵢWᵢRᵢ)/(IⱼWⱼRⱼ)",
      "legal_status": "法哲学上的论证结构；序数等级的数字编码并非客观测量、概率或香港法定评分表。",
      "assumptions": [
        "I、W采用轻/中/重的1、2、4等级编码；Iᵢ为原则i受干预程度，Iⱼ为实现相冲突原则j的重要程度。",
        "R采用1、0.5、0.25的认知可靠性等级编码。",
        "每个评分及其理由由使用者外部提供，两个原则使用相同评分口径。"
      ],
      "limitations": [
        "结果依赖赋值；比值为2不证明某权利客观上重要两倍。",
        "R不是案件胜诉概率；比值不是合法性概率。",
        "适合展示理由与敏感性，不替代合法性、适当性、必要性等适用审查步骤。"
      ],
      "required_legal_findings": [
        "两个原则及具体冲突",
        "适用的权利限制与比例审查框架",
        "每个赋值的事实和规范理由"
      ],
      "source_ids": [
        "alexy-2014"
      ],
      "fields": [
        {
          "id": "I_i",
          "label": "原则i的干预强度",
          "unit": "理论等级",
          "description": "",
          "type": "number",
          "enum": [
            1,
            2,
            4
          ]
        },
        {
          "id": "W_i",
          "label": "原则i的抽象重要性",
          "unit": "理论等级",
          "description": "",
          "type": "number",
          "enum": [
            1,
            2,
            4
          ]
        },
        {
          "id": "R_i",
          "label": "原则i前提可靠性",
          "unit": "理论等级",
          "description": "",
          "type": "number",
          "enum": [
            1,
            0.5,
            0.25
          ]
        },
        {
          "id": "I_j",
          "label": "原则j实现的重要程度",
          "unit": "理论等级",
          "description": "",
          "type": "number",
          "enum": [
            1,
            2,
            4
          ]
        },
        {
          "id": "W_j",
          "label": "原则j的抽象重要性",
          "unit": "理论等级",
          "description": "",
          "type": "number",
          "enum": [
            1,
            2,
            4
          ]
        },
        {
          "id": "R_j",
          "label": "原则j前提可靠性",
          "unit": "理论等级",
          "description": "",
          "type": "number",
          "enum": [
            1,
            0.5,
            0.25
          ]
        }
      ],
      "outputs": [
        {
          "id": "weighted_i",
          "label": "原则i的理论乘积",
          "unit": "理论分值",
          "formula": "IᵢWᵢRᵢ",
          "expression": {
            "op": "mul",
            "args": [
              {
                "var": "input.I_i"
              },
              {
                "var": "input.W_i"
              },
              {
                "var": "input.R_i"
              }
            ]
          }
        },
        {
          "id": "weighted_j",
          "label": "原则j的理论乘积",
          "unit": "理论分值",
          "formula": "IⱼWⱼRⱼ",
          "expression": {
            "op": "mul",
            "args": [
              {
                "var": "input.I_j"
              },
              {
                "var": "input.W_j"
              },
              {
                "var": "input.R_j"
              }
            ]
          }
        },
        {
          "id": "weight_ratio",
          "label": "原则i相对于j的权重比",
          "unit": "理论比值",
          "formula": "(IᵢWᵢRᵢ)/(IⱼWⱼRⱼ)",
          "expression": {
            "op": "div",
            "args": [
              {
                "var": "out.weighted_i"
              },
              {
                "var": "out.weighted_j"
              }
            ]
          }
        }
      ],
      "constraints": [],
      "example_inputs": {
        "I_i": 4,
        "W_i": 2,
        "R_i": 0.5,
        "I_j": 2,
        "W_j": 2,
        "R_j": 1
      },
      "example_basis": "hypothetical"
    },
    {
      "id": "bayes",
      "version": "1",
      "title": "贝叶斯更新：事实命题与证据",
      "category": "evidence",
      "question": "对一个明确事实命题，新证据在指定假设下如何更新概率？",
      "output_kind": "conditional_hypothesis_probability",
      "formula_summary": "P(H|E) = LR·p/(1−p+LR·p)",
      "legal_status": "统计证据解释工具；输出不是有罪概率、法律责任概率或自动证明标准。",
      "assumptions": [
        "H与非H构成所选分析中的互斥且穷尽假说。",
        "先验与似然比有独立依据；本模型只处理一个合并似然比。",
        "似然比LR=P(E|H)/P(E|非H)，不能把P(E|H)误当后验。"
      ],
      "limitations": [
        "多项相关证据不能直接相乘似然比；相关结构须另行建模。",
        "先验和似然比不可靠时，精确的小数不代表可靠结论。",
        "先验为1且LR为0导致不相容的零分母，必须拒绝计算。"
      ],
      "required_legal_findings": [
        "待证明的具体事实命题",
        "证据可采性、可靠性及证明标准",
        "先验与似然比来源"
      ],
      "source_ids": [
        "nist-bayes"
      ],
      "fields": [
        {
          "id": "prior",
          "label": "事实命题先验概率",
          "unit": "0–1比例",
          "description": "",
          "type": "number",
          "min": 0,
          "max": 1
        },
        {
          "id": "likelihood_ratio",
          "label": "证据似然比",
          "unit": "比值",
          "description": "",
          "type": "number",
          "min": 0
        }
      ],
      "outputs": [
        {
          "id": "denominator",
          "label": "归一化分母",
          "unit": "无量纲",
          "formula": "1−p+LR·p",
          "expression": {
            "op": "add",
            "args": [
              {
                "op": "sub",
                "args": [
                  1,
                  {
                    "var": "input.prior"
                  }
                ]
              },
              {
                "op": "mul",
                "args": [
                  {
                    "var": "input.likelihood_ratio"
                  },
                  {
                    "var": "input.prior"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "posterior",
          "label": "指定事实命题的条件后验概率",
          "unit": "0–1比例",
          "formula": "LR·p/(1−p+LR·p)",
          "expression": {
            "op": "div",
            "args": [
              {
                "op": "mul",
                "args": [
                  {
                    "var": "input.likelihood_ratio"
                  },
                  {
                    "var": "input.prior"
                  }
                ]
              },
              {
                "var": "out.denominator"
              }
            ]
          }
        }
      ],
      "constraints": [
        {
          "expression": {
            "op": "gt",
            "args": [
              {
                "op": "add",
                "args": [
                  {
                    "op": "sub",
                    "args": [
                      1,
                      {
                        "var": "input.prior"
                      }
                    ]
                  },
                  {
                    "op": "mul",
                    "args": [
                      {
                        "var": "input.likelihood_ratio"
                      },
                      {
                        "var": "input.prior"
                      }
                    ]
                  }
                ]
              },
              0
            ]
          },
          "message": "先验与似然比产生零分母，无法更新概率。"
        }
      ],
      "example_inputs": {
        "prior": 0.2,
        "likelihood_ratio": 8
      },
      "example_basis": "hypothetical"
    },
    {
      "id": "deterrence",
      "version": "1",
      "title": "预期制裁：执行概率与社会损害",
      "category": "policy",
      "question": "在简化威慑假设下，何种制裁额的期望值等于社会损害？",
      "output_kind": "policy_benchmark",
      "formula_summary": "F* = H/q；qF* = H",
      "legal_status": "法律经济学的政策基准；不是法定罚款、量刑建议或最低处罚要求。",
      "assumptions": [
        "行为人风险中性且了解最终受罚概率。",
        "q为最终实际受制裁的概率，已包含必要执行环节。",
        "社会损害可以货币化，忽略制裁成本、错误处罚及行为收益差异。"
      ],
      "limitations": [
        "不能突破法律授权、罚款上限、比例原则或支付能力约束。",
        "q接近零会产生极大基准，体现简化模型局限。",
        "此模型仅将预期制裁与损害相等，不单独证明最佳执法或完全威慑。"
      ],
      "required_legal_findings": [
        "处罚的法律授权与上限",
        "受罚概率和损害估计依据",
        "比例、错误风险及执行成本"
      ],
      "source_ids": [
        "shavell-enforcement"
      ],
      "fields": [
        {
          "id": "harm",
          "label": "每次行为的社会损害",
          "unit": "同一货币单位",
          "description": "",
          "type": "number",
          "min": 0
        },
        {
          "id": "sanction_probability",
          "label": "最终受制裁概率",
          "unit": "0–1比例",
          "description": "",
          "type": "number",
          "min": 0,
          "max": 1
        }
      ],
      "outputs": [
        {
          "id": "benchmark_sanction",
          "label": "简化政策制裁基准",
          "unit": "货币",
          "formula": "H/q",
          "expression": {
            "op": "div",
            "args": [
              {
                "var": "input.harm"
              },
              {
                "var": "input.sanction_probability"
              }
            ]
          }
        },
        {
          "id": "expected_sanction",
          "label": "基准下预期制裁",
          "unit": "货币",
          "formula": "qF*",
          "expression": {
            "op": "mul",
            "args": [
              {
                "var": "input.sanction_probability"
              },
              {
                "var": "out.benchmark_sanction"
              }
            ]
          }
        }
      ],
      "constraints": [
        {
          "expression": {
            "op": "gt",
            "args": [
              {
                "var": "input.sanction_probability"
              },
              0
            ]
          },
          "message": "最终受制裁概率必须大于0。"
        }
      ],
      "example_inputs": {
        "harm": 100000,
        "sanction_probability": 0.2
      },
      "example_basis": "hypothetical"
    },
    {
      "id": "coase",
      "version": "1",
      "title": "社会成本比较：冲突解决方案",
      "category": "decision",
      "question": "给定可行方案，哪一项计入交易及执行成本后的社会总成本最低？",
      "output_kind": "alternative_cost_comparison",
      "formula_summary": "TCₐ = 预防成本+残余损害+交易成本+执行成本；比较min(TCₐ)",
      "legal_status": "受科斯分析启发的成本比较；不是一条可直接决定权利归属的法律公式。",
      "assumptions": [
        "各方案使用同一期间、货币与社会评价范围。",
        "各类成本不重复计数，纯粹内部转移不误计为新增社会成本。",
        "方案可行性由外部确认；并列最低方案全部保留。"
      ],
      "limitations": [
        "总成本最低不决定谁有权利、谁付钱或何种救济合法。",
        "非货币利益、分配影响及协商障碍可能改变实际选择。",
        "没有列入的方案不被模型评价。"
      ],
      "required_legal_findings": [
        "权利归属与可用救济",
        "方案法律及实际可行性",
        "评价范围、成本归属及证据"
      ],
      "source_ids": [
        "coase-1960"
      ],
      "fields": [
        {
          "id": "alternatives",
          "label": "候选方案",
          "unit": "",
          "description": "",
          "type": "object_array",
          "minItems": 1,
          "maxItems": 100,
          "items": [
            {
              "id": "name",
              "label": "方案名称",
              "unit": "",
              "description": "",
              "type": "string"
            },
            {
              "id": "prevention_cost",
              "label": "预防成本",
              "unit": "同一货币单位",
              "description": "",
              "type": "number",
              "min": 0
            },
            {
              "id": "residual_harm",
              "label": "残余损害",
              "unit": "同一货币单位",
              "description": "",
              "type": "number",
              "min": 0
            },
            {
              "id": "transaction_cost",
              "label": "交易成本",
              "unit": "同一货币单位",
              "description": "",
              "type": "number",
              "min": 0
            },
            {
              "id": "enforcement_cost",
              "label": "执行成本",
              "unit": "同一货币单位",
              "description": "",
              "type": "number",
              "min": 0
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "total_costs",
          "label": "各方案总成本（依输入顺序）",
          "unit": "货币列表",
          "formula": "各方案四项成本之和",
          "expression": {
            "op": "map",
            "items": {
              "var": "input.alternatives"
            },
            "value": {
              "op": "add",
              "args": [
                {
                  "var": "item.prevention_cost"
                },
                {
                  "var": "item.residual_harm"
                },
                {
                  "var": "item.transaction_cost"
                },
                {
                  "var": "item.enforcement_cost"
                }
              ]
            }
          }
        },
        {
          "id": "minimum_total_cost",
          "label": "最低总成本",
          "unit": "货币",
          "formula": "min(TC)",
          "expression": {
            "op": "min",
            "args": [
              {
                "var": "out.total_costs"
              }
            ]
          }
        },
        {
          "id": "minimum_indices",
